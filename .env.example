# MCP Conductor 环境变量示例。
# 复制为 .env 并按需修改；docker compose 会自动读取 .env 注入服务。

# 监听
CONDUCTOR_SERVER_HOST=0.0.0.0
CONDUCTOR_SERVER_PORT=8080

# 存储（MVP 默认 memory；mysql 5.7+ 驱动已实现，DSN 需 parseTime=true&loc=UTC&charset=utf8mb4）
CONDUCTOR_DATABASE_DRIVER=memory
CONDUCTOR_DATABASE_DSN=conductor:conductor@tcp(localhost:3306)/conductor?parseTime=true&loc=UTC&charset=utf8mb4

# Redis（关闭时以内存模式运行）
CONDUCTOR_REDIS_ENABLED=false
CONDUCTOR_REDIS_ADDR=localhost:6379
CONDUCTOR_REDIS_PASSWORD=

# 限流
CONDUCTOR_RATELIMIT_ENABLED=false
CONDUCTOR_RATELIMIT_QPS=100

# 认证（subject:key 冒号分隔，可多个，逗号连接）
CONDUCTOR_AUTH_ENABLED=false
CONDUCTOR_AUTH_API_KEYS=admin:dev-admin-key

# 凭证加密（MySQL 落库用；64 位 hex = AES-256；为空时拒绝存明文）
CONDUCTOR_CREDENTIALS_ENCRYPTION_KEY=

# 日志/观测
CONDUCTOR_LOGGING_LEVEL=info
CONDUCTOR_GATEWAY_UPSTREAM_TIMEOUT_MS=10000
# MCP Conductor —— 本文件仅供 docker compose 使用（可选覆盖）。
#
# 本地直接运行（go run ./cmd/conductor）读的是 config.yaml，与本文件无关。
# 复制为 .env 后 docker compose 读取它作为宿主机连接与凭据覆盖；未设置项采用
# docker-compose.yml 内的默认值（host.docker.internal 等）。

# 宿主机 MySQL（容器内经 host.docker.internal 访问；账号密码不写进 yml）
CONDUCTOR_DB_USER=root
CONDUCTOR_DB_PASSWORD=
CONDUCTOR_DB_HOST=host.docker.internal
CONDUCTOR_DB_PORT=3306
CONDUCTOR_DB_NAME=conductor

# 宿主机 Redis（仅当同时开启限流时用于分布式 per-key 限流）
CONDUCTOR_REDIS_ENABLED=false
CONDUCTOR_REDIS_HOST=host.docker.internal
CONDUCTOR_REDIS_PORT=6379
CONDUCTOR_REDIS_PASSWORD=
# CONDUCTOR_REDIS_DB=0        # Redis DB 序号（代码默认 0）

# 认证（默认开启）：Console 登录 = 管理员账号密码；/api 控制面亦接受 operator token。
# 未配置时首次启动会生成并打印一次（admin 密码 / operator token 作为内部凭据）。
CONDUCTOR_AUTH_ENABLED=true
CONDUCTOR_AUTH_OPERATOR_TOKEN=
CONDUCTOR_AUTH_TOKEN_SECRET=
CONDUCTOR_AUTH_ADMIN_USERNAME=admin
CONDUCTOR_AUTH_ADMIN_PASSWORD=
CONDUCTOR_AUTH_API_KEYS=
# CONDUCTOR_AUTH_SESSION_TTL_MINUTES=720   # 登录会话有效期（分钟，默认 12h）
# Console 登录防爆破（默认开启）：按来源 IP 统计登录失败，窗口内达上限临时封禁该 IP，
# 到期自动解封；仅作用于登录端点（operator_token 直连 /api 不受影响）。
# CONDUCTOR_AUTH_LOGIN_LIMIT_ENABLED=true
# CONDUCTOR_AUTH_LOGIN_LIMIT_MAX_FAILURES=5        # 窗口内失败次数阈值
# CONDUCTOR_AUTH_LOGIN_LIMIT_WINDOW_SECONDS=300    # 失败计数滑动窗口（秒，默认 5 分钟）
# CONDUCTOR_AUTH_LOGIN_LIMIT_BAN_SECONDS=900       # 临时封禁时长（秒，默认 15 分钟）

# 凭证加密 AES-256 密钥（64 位 hex）；连 MySQL 存上游凭证时需要
CONDUCTOR_CREDENTIALS_ENCRYPTION_KEY=

# 限流 / 日志（/mcp 三级：key 级按 AccessKey 配额；IP 级 ip_qps=0 → 沿用 qps；
# 全局级 global_qps>0 → 启用整网关总闸）
CONDUCTOR_RATELIMIT_ENABLED=false
CONDUCTOR_RATELIMIT_QPS=20    # 维度默认每秒速率（查询型示例：20/s → ~1200/分）；代码默认 qps=0/burst=1
# CONDUCTOR_RATELIMIT_BURST=10
# CONDUCTOR_RATELIMIT_WINDOW_SECONDS=60   # 滑动窗口(秒,1..3600，默认 60=1 分钟)：任意 N 秒内 ≤ QPS×N
# CONDUCTOR_RATELIMIT_IP_QPS=100          # 单来源 IP：100/s → ~6000/分
# CONDUCTOR_RATELIMIT_IP_BURST=20
# CONDUCTOR_RATELIMIT_GLOBAL_QPS=500      # 全局总闸：500/s → ~30000/分
# CONDUCTOR_RATELIMIT_GLOBAL_BURST=100
# 自动封禁：窗口内被限流 429 达次数即临时封禁（TTL 自动解封，进程内）
# CONDUCTOR_RATELIMIT_AUTO_BAN_ENABLED=true
# CONDUCTOR_RATELIMIT_AUTO_BAN_WINDOW_SECONDS=60
# CONDUCTOR_RATELIMIT_AUTO_BAN_MAX_VIOLATIONS=5
# CONDUCTOR_RATELIMIT_AUTO_BAN_BAN_SECONDS=300

# 数据面治理种子：来源 IP/CIDR 封禁（仅 /mcp）；Console「防护」页保存后以保存值为准。
# CONDUCTOR_SECURITY_IP_BLOCKLIST=203.0.113.9,198.51.100.0/24
# 可信豁免白名单（命中来源不受 IP 黑名单/自动封禁/IP级限流影响）
# CONDUCTOR_SECURITY_IP_WHITELIST=127.0.0.1,10.0.0.0/8
CONDUCTOR_LOGGING_LEVEL=info
# CONDUCTOR_LOGGING_FORMAT=json   # text（默认）| json（容器/集中采集）

# 客户端 IP：网关在反向代理后时列出可信代理（IP 或 CIDR，逗号分隔）；请求来自
# 可信代理时才信任 X-Forwarded-For / X-Real-IP。默认只认直连地址（防伪造）。
# CONDUCTOR_SERVER_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# 观测（可选）：捕获 tools/call 入参供 Traffic 回放（默认关，含隐私）；趋势保留天数
# CONDUCTOR_OBSERVABILITY_RECORD_ARGS=false
# CONDUCTOR_OBSERVABILITY_SAMPLE_RATE=1.0
# CONDUCTOR_OBSERVABILITY_TREND_RETENTION_DAYS=7

# 端口：CONDUCTOR_HTTP_PORT 是宿主机对外映射（改它只影响 host 侧）；容器内
# 实际监听端口读 CONDUCTOR_SERVER_PORT（需改容器内端口时二者一起改）。
CONDUCTOR_HTTP_PORT=18110
# CONDUCTOR_SERVER_PORT=18110
